{
  "name": "pi-harness",
  "version": "1.0.0",
  "description": "Minimal pi outer harness — bare-bones file-memory + sensors + eval (Fowler/Weng) — frozen v1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "sleep": "tsx memory/sleep.ts",
    "judge": "tsx sensors/judge.ts",
    "sensor": "tsx sensors/computational.ts",
    "eval": "tsx sensors/run-eval.ts",
    "improve": "tsx memory/self-improve.ts",
    "vector:reindex": "tsx memory/vector.ts reindex",
    "vector:recall": "tsx memory/vector.ts recall",
    "hashline:compare": "tsx sensors/run-hashline-compare.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@oh-my-pi/hashline": "18.1.5",
    "fastembed": "2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.0"
  }
}
