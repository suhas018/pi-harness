{
  "name": "pi-harness",
  "version": "2.0.0",
  "description": "Minimal pi outer harness — v2.0 Context-efficiency (Chasen 4 gates) — thin resident + filtered tools + subagents + pi-ask",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit",
    "sleep": "tsx memory/sleep.ts",
    "judge": "tsx sensors/judge.ts",
    "sensor": "tsx sensors/computational.ts",
    "eval": "tsx sensors/run-eval.ts",
    "improve": "tsx memory/self-improve.ts",
    "vector:reindex": "tsx memory/vector.ts reindex",
    "vector:recall": "tsx memory/vector.ts recall",
    "hashline:compare": "tsx sensors/run-hashline-compare.ts",
    "edit:benchmark": "tsx sensors/run-edit-benchmark.ts",
    "harbor:subset": "tsx sensors/run-harbor-subset.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@oh-my-pi/hashline": "18.1.5",
    "@sinclair/typebox": "^0.34.0",
    "fastembed": "2.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
